<%- | String $description,
      String $command,
      String $user,
      Variant[String, Boolean] $group,
      Array[String] $after,
      Array[String] $wants,
      Optional[String] $exec_stop_post,
| -%>
# MANAGED BY PUPPET
[Unit]
Description=<%= $description %>
<% unless $after.empty { -%>
After=<%= $after.join(' ') %>
<% } -%>
<% unless $wants.empty { -%>
Wants=<%= $wants.join(' ') %>
<% } -%>

[Service]
Type=oneshot
ExecStart=<%= $command %>
<% if $exec_stop_post { -%>
ExecStopPost=<%= $exec_stop_post %>
<% } -%>
User=<%= $user %>
<% if $group { -%>
Group=<%= $group %>
<% } -%>
