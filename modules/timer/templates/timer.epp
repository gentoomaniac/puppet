<%- | String $description,
      Array[String] $on_calendar,
      Optional[String] $on_boot_sec,
      Optional[String] $on_unit_active_sec,
      Optional[String] $randomized_delay_sec,
      Boolean $persistent,
      String $unit,
| -%>
# MANAGED BY PUPPET
[Unit]
Description=<%= $description %>

[Timer]
<% $on_calendar.each |$calendar| { -%>
OnCalendar=<%= $calendar %>
<% } -%>
<% if $on_boot_sec { -%>
OnBootSec=<%= $on_boot_sec %>
<% } -%>
<% if $on_unit_active_sec { -%>
OnUnitActiveSec=<%= $on_unit_active_sec %>
<% } -%>
<% if $randomized_delay_sec { -%>
RandomizedDelaySec=<%= $randomized_delay_sec %>
<% } -%>
Persistent=<%= $persistent %>
Unit=<%= $unit %>

[Install]
WantedBy=timers.target
